# Copy to .env.local and fill in. Never commit real values.
# Point it at a DEVELOPMENT database (e.g. a Neon branch), not production.

# Database (Neon: "Connect" → pooled for the app, direct for migrations)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# LLM (free key at https://console.groq.com/keys)
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_STRUCTURED_MODEL="openai/gpt-oss-120b"
# LLM eval only (RUN_LLM_EVAL=1 npm run eval): a key from a SEPARATE Groq
# account. The daily token limit is per organization, so the production key
# must not be used for evals; the eval never reads GROQ_API_KEY.
# GROQ_EVAL_API_KEY=""

# Sign-in with GitHub or Google (optional). Callbacks:
# /api/auth/callback/github, /api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Repository import: a read-only GitHub App, one per environment (optional;
# ZIP upload works without it). Callback: /api/github/app/callback.
# Setup: docs/runbooks/github-app.md
# GITHUB_APP_ID=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_APP_PRIVATE_KEY=""

# ZIP uploads up to 100 MB through Neon Object Storage (optional; without it,
# uploads are imported in the request, up to 4 MB). Setup:
# docs/runbooks/object-storage.md
# NEON_STORAGE_ENDPOINT=""
# NEON_STORAGE_REGION=""
# NEON_STORAGE_BUCKET=""
# NEON_STORAGE_ACCESS_KEY_ID=""
# NEON_STORAGE_SECRET_ACCESS_KEY=""

# Error tracking (optional; without a DSN, Sentry stays off)
# NEXT_PUBLIC_SENTRY_DSN=""

# Billing (optional; use Stripe test mode keys locally)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PREMIUM=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Daily cron that fails projects stuck in "processing" (optional; Vercel
# sends it as a Bearer token). Production only, at least 32 characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=""
