# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# Claude Code (local tooling)
.claude/skills/
.claude/settings.local.json

/test-results/
/playwright-report/
/blob-report/
/playwright/.cache

# Local debug script (not part of the app)
.dbcheck.mjs

# Eval downloads (real repositories, never committed)
/evals/.cache

# Workflow SDK: local World data and generated routes (ADR-005)
/.workflow-data
/src/app/.well-known/workflow
/.swc
.coverage/

# Vitest cache (JSON reporter output)
/.vitest/

# graphify (local knowledge-graph output)
/graphify-out/

# editors and OS
.idea/
Thumbs.db
