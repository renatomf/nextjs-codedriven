{
  "name": "nextjs-codedriven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "lint:arch:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "measure:code": "node scripts/measure-code.mjs",
    "measure:functions": "node scripts/measure-functions.mjs",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:chart": "node scripts/dogfooding-chart.mjs",
    "measure:coverage": "node scripts/measure-coverage.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.54",
    "@ai-sdk/react": "^4.0.130",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "@sentry/nextjs": "^11.4.0",
    "@vercel/functions": "^3.9.10",
    "ai": "^7.0.114",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "ignore": "^7.0.12",
    "input-otp": "^1.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tw-animate-css": "^1.4.0",
    "workflow": "5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "tree-sitter-typescript": {
      "tree-sitter": "$tree-sitter"
    },
    "@workflow/core": {
      "devalue": "^5.9.4",
      "nanoid": "^5.1.16"
    }
  }
}
